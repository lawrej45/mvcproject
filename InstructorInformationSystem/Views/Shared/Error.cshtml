@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex justify-content-center">
    <div class="card app-card w-100" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="delete-icon mb-3"><i class="bi bi-exclamation-octagon"></i></div>
            <h1 class="h4 mb-2">Something went wrong.</h1>
            <p class="text-muted">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <p class="small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
            }

            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-primary mt-2">Back to Dashboard</a>
        </div>
    </div>
</div>