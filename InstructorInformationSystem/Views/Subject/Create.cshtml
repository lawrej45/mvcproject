@model Subject
@{
    ViewData["Title"] = "Add Subject";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Add Subject</h1>
    <p class="text-muted mb-0">Enter the subject details below.</p>
</div>

<div class="card app-card">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SubjectCode" class="form-label fw-semibold"></label>
                    <input asp-for="SubjectCode" class="form-control" />
                    <span asp-validation-for="SubjectCode" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="SubjectName" class="form-label fw-semibold"></label>
                    <input asp-for="SubjectName" class="form-control" />
                    <span asp-validation-for="SubjectName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Units" class="form-label fw-semibold"></label>
                    <input asp-for="Units" class="form-control" />
                    <span asp-validation-for="Units" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="InstructorName" class="form-label fw-semibold"></label>
                    <input asp-for="InstructorName" class="form-control" />
                    <span asp-validation-for="InstructorName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>