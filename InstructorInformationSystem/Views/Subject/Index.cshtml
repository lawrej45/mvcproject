@model List<Subject>
@{
    ViewData["Title"] = "Subjects";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Subjects</h1>
        <p class="text-muted mb-0">Manage the subjects and their assigned instructors.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Subject
    </a>
</div>

<div class="card app-card">
    <div class="card-body p-4">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-journal-bookmark"></i>
                <p class="mb-2">No subjects yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Add a subject</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Subject Name</th>
                            <th class="text-center">Units</th>
                            <th>Instructor</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model)
                        {
                            <tr>
                                <td><span class="badge code-badge">@subject.SubjectCode</span></td>
                                <td class="fw-semibold">@subject.SubjectName</td>
                                <td class="text-center">@subject.Units</td>
                                <td>@subject.InstructorName</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@subject.SubjectId" class="btn btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@subject.SubjectId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@subject.SubjectId" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>