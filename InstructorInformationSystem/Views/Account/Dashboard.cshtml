@model InstructorInformationSystem.Models.UserAccount
@{
    ViewData["Title"] = "Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.FirstName) || Model.FirstName.Contains('@') ? string.Empty : Model.FirstName.Trim();
    var lastName = string.IsNullOrWhiteSpace(Model.LastName) || Model.LastName.Contains('@') ? string.Empty : Model.LastName.Trim();
    var accountName = $"{firstName} {lastName}".Trim();
    if (string.IsNullOrWhiteSpace(accountName))
        accountName = "Account holder";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Welcome, @Model.FirstName!</h1>
    <p class="text-muted mb-0">Here is an overview of your instructor information system.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card stat-card stat-blue h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Instructors</div>
                    <div class="display-6 fw-bold">@ViewBag.InstructorCount</div>
                </div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card stat-card stat-green h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Subjects</div>
                    <div class="display-6 fw-bold">@ViewBag.SubjectCount</div>
                </div>
                <i class="bi bi-journal-bookmark stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card stat-card stat-purple h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Admin ID</div>
                    <div class="h4 fw-bold mb-0">@Model.AdminId</div>
                </div>
                <i class="bi bi-person-badge stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card app-card h-100">
            <div class="card-body p-3 p-md-4">
                <div class="profile-banner mb-4">
                    <div class="profile-avatar"><i class="bi bi-person-fill"></i></div>
                    <div class="min-w-0">
                        <span class="detail-label">MY ACCOUNT</span>
                        <h2 class="h4 mb-1">@accountName</h2>
                        <p class="text-muted mb-0">Administrator profile</p>
                    </div>
                    <span class="profile-id-badge"><i class="bi bi-person-badge me-1"></i>@Model.AdminId</span>
                </div>

                <section class="profile-info-section">
                    <h3 class="profile-info-heading"><i class="bi bi-shield-check me-2"></i>Account Information</h3>
                    <div class="profile-info-list">
                        <div class="profile-info-item">
                            <span class="profile-info-label">Admin ID</span>
                            <span class="profile-info-value">@(string.IsNullOrWhiteSpace(Model.AdminId) ? "Not provided" : Model.AdminId)</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="profile-info-label">Email Address</span>
                            <span class="profile-info-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "Not provided" : Model.Email)</span>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card app-card h-100">
            <div class="card-body p-4">
                <h2 class="h5 mb-3"><i class="bi bi-lightning-charge me-2 text-warning"></i>Quick Actions</h2>
                <div class="d-grid gap-2">
                    <a asp-controller="Instructor" asp-action="Index" class="btn btn-outline-primary text-start">
                        <i class="bi bi-people me-2"></i>Manage Instructors
                    </a>
                    <a asp-controller="Instructor" asp-action="Create" class="btn btn-outline-primary text-start">
                        <i class="bi bi-person-plus me-2"></i>Add Instructor
                    </a>
                    <a asp-controller="Subject" asp-action="Index" class="btn btn-outline-primary text-start">
                        <i class="bi bi-journal-bookmark me-2"></i>Manage Subjects
                    </a>
                    <a asp-controller="Subject" asp-action="Create" class="btn btn-outline-primary text-start">
                        <i class="bi bi-plus-square me-2"></i>Add Subject
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>