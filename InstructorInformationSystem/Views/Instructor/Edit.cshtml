@model Instructor
@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Edit Instructor</h1>
    <p class="text-muted mb-0">Update the selected instructor's information.</p>
</div>

<div class="card app-card">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            @if (ViewBag.CompletionNotice is string completionNotice)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@completionNotice
                </div>
                <input type="hidden" name="completeProfile" value="true" />
            }
            <div asp-validation-summary="All" class="alert alert-danger py-2"></div>

            <partial name="_Form" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>