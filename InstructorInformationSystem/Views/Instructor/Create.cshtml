@model Instructor
@{
    ViewData["Title"] = "Add Instructor";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Add Instructor</h1>
    <p class="text-muted mb-0">Enter the instructor's details below.</p>
</div>

<div class="card app-card">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <partial name="_Form" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>