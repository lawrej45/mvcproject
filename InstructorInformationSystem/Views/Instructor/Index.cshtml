@model List<Instructor>
@{
    ViewData["Title"] = "Instructors";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var hasPreviousPage = (bool)(ViewBag.HasPreviousPage ?? false);
    var hasNextPage = (bool)(ViewBag.HasNextPage ?? false);
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Instructors</h1>
        <p class="text-muted mb-0">Manage instructor records.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Instructor
    </a>
</div>

<div class="card app-card">
    <div class="card-body p-4">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <p class="mb-2">No instructors have been added yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Add the first instructor</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Instructor ID</th>
                            <th>Full Name</th>
                            <th>Designation</th>
                            <th>Contact Number</th>
                            <th>E-mail Address</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var instructor in Model)
                        {
                            <tr>
                                <td>@instructor.InstructorId</td>
                                <td class="fw-semibold">@(string.IsNullOrWhiteSpace(instructor.FullName) ? "Not provided" : instructor.FullName)</td>
                                <td>@(string.IsNullOrWhiteSpace(instructor.Designation) ? "Not provided" : instructor.Designation)</td>
                                <td>@(string.IsNullOrWhiteSpace(instructor.ContactNumber) ? "Not provided" : instructor.ContactNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(instructor.EmailAddress) ? "Not provided" : instructor.EmailAddress)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@instructor.Id" class="btn btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@instructor.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@instructor.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (hasPreviousPage || hasNextPage)
{
    <nav class="mt-3" aria-label="Instructor list pages">
        <ul class="pagination">
            @if (hasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
            }
            <li class="page-item disabled" aria-current="page">
                <span class="page-link">Page @currentPage</span>
            </li>
            @if (hasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
}
