@model Instructor
@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="d-flex justify-content-center">
    <div class="card app-card w-100" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="delete-icon mb-3"><i class="bi bi-exclamation-triangle"></i></div>
            <h1 class="h4 mb-2">Delete Instructor?</h1>
            <p class="text-muted mb-4">
                This will permanently remove <strong>@Model.FullName</strong> (@Model.Designation) from the system.
            </p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger me-2"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>